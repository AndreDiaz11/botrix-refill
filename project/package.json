{
  "name": "botrix-refill",
  "version": "1.7.0",
  "description": "Monitor de tienda Botrix con notificaciones en tiempo real",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --win portable"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.botrixrefill.app",
    "productName": "Botrix Refill",
    "icon": "resources/icon.png",
    "directories": { "output": "dist-electron" },
    "asar": true,
    "extraResources": [
      { "from": "resources/", "to": "resources/" }
    ],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }]
    },
    "files": [
      "out/**/*",
      "package.json"
    ]
  }
}
