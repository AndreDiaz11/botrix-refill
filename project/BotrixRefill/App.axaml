<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BotrixRefill.App"
             xmlns:local="using:BotrixRefill"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button.titlebar-btn">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.titlebar-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#48FFFFFF" />
        </Style>
        <Style Selector="Button.titlebar-btn.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B2DC3232" />
        </Style>

        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8" />
        </Style>
        <Style Selector="Button.btn-primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#93B4F0" />
        </Style>

        <Style Selector="Button.btn-ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Button.btn-ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="#2563EB" />
        </Style>

        <Style Selector="Button.btn-stop-hdr">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#E0344C" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TextBox.form-input">
            <Setter Property="Background" Value="#F7F8FC" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBox.form-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#2563EB" />
        </Style>

        <Style Selector="Button.accordion-head">
            <Setter Property="Background" Value="#F7F8FC" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.accordion-head:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EDEEF6" />
        </Style>

        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="Border.badge TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Application.Styles>
</Application>
