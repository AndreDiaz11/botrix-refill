<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BotrixRefill.ViewModels"
             xmlns:local="using:BotrixRefill.Converters"
             xmlns:beh="using:BotrixRefill.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="BotrixRefill.Views.ShopView"
             x:DataType="vm:ShopViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="RewardRowTemplate" DataType="vm:RewardCardViewModel">
            <Grid ColumnDefinitions="300,110,150,140,*" Height="46">
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" Foreground="#111827" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding PriceText}" FontSize="13" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="{Binding BadgeBg}" CornerRadius="20" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BadgeLabel}" FontSize="11" FontWeight="Bold" Foreground="{Binding BadgeFg}" />
                </Border>
                <Panel Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="{Binding ActionLabel}" Command="{Binding CopyCommand}"
                            Padding="12,7" FontSize="11.5" FontWeight="Bold"
                            Background="#2563EB" Foreground="White" CornerRadius="8" BorderThickness="0">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#1D4ED8" />
                            </Style>
                        </Button.Styles>
                    </Button>
                </Panel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RewardGroupTemplate" DataType="vm:RewardGroup">
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,14,16,10">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{Binding IconBg}">
                            <TextBlock Text="{Binding IconGlyph}" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Label}" FontSize="14.5" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid ColumnDefinitions="300,110,150,140,*" Margin="16,0,16,6">
                        <TextBlock Grid.Column="0" Text="Recompensa" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" />
                        <TextBlock Grid.Column="1" Text="Puntos" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" />
                        <TextBlock Grid.Column="2" Text="Disponibilidad" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" />
                        <TextBlock Grid.Column="3" Text="Acción" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" />
                    </Grid>
                    <Border Height="1" Background="#F0F1F5" Margin="16,0,16,4" />

                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource RewardRowTemplate}" Margin="16,0,16,8">
                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,0,0" />
                            </Style>
                        </ItemsControl.Styles>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Background="#F2F3F9">

        <!-- Header -->
        <Border Grid.Row="0" BoxShadow="0 4 14 0 #26000000" ClipToBounds="False">
        <Panel ClipToBounds="True">
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#173B8F" Offset="0" />
                        <GradientStop Color="#2251D9" Offset="0.55" />
                        <GradientStop Color="#4C3FE0" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Ellipse Width="260" Height="260" Fill="#14FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-80,0">
                <Ellipse.Effect><BlurEffect Radius="50" /></Ellipse.Effect>
            </Ellipse>

            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" MaxWidth="1080" Margin="22,0,22,0" Height="64"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <!-- Avatar -->
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#26FFFFFF"
                        BorderBrush="#40FFFFFF" BorderThickness="2">
                    <Border Width="34" Height="34" CornerRadius="17" ClipToBounds="True">
                        <Panel>
                            <TextBlock Text="{Binding User.Name, Converter={x:Static local:InitialConverter.Instance}}"
                                       FontSize="14" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding User.Picture, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                            <Image beh:WebImageBehavior.Url="{Binding User.Picture}" Stretch="UniformToFill"
                                   IsVisible="{Binding User.Picture, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </Panel>
                    </Border>
                </Border>

                <!-- Nombre + puntos juntos, streamer como caption debajo -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding User.Name}" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        <Border Background="#1EFFFFFF" CornerRadius="20" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="⬡" FontSize="12" Foreground="#FBBF24" VerticalAlignment="Center" />
                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"
                                           Text="{Binding User.Points, StringFormat={}{0:N0}}" />
                                <TextBlock Text="pts" FontSize="9.5" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                                <Button Content="↻" Command="{Binding RefreshPointsCommand}" IsEnabled="{Binding !PtsCooldownActive}"
                                        Width="18" Height="18" Padding="0" FontSize="9" Background="#26FFFFFF" Foreground="White"
                                        CornerRadius="9" BorderThickness="0"
                                        IsVisible="{Binding !PtsCooldownActive}" />
                                <TextBlock Text="{Binding PtsCooldown, StringFormat={}{0}s}" FontSize="9.5" Foreground="#CCFFFFFF"
                                           IsVisible="{Binding PtsCooldownActive}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding StreamerDisplay, StringFormat=Revisado en: {0}}" FontSize="10.5" Foreground="#CBD5FF" />
                    <TextBlock Text="{Binding PointsErrorMessage}" FontSize="9.5" FontWeight="Bold" Foreground="#FCA5A5" TextWrapping="Wrap" MaxWidth="280"
                               IsVisible="{Binding PointsErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <!-- Última revisión + Detener, agrupados y separados del bloque de la izquierda -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            ToolTip.Tip="Última revisión">
                    <Border Width="24" Height="24" CornerRadius="12" Background="White">
                        <TextBlock Text="🕐" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding LastUpdate, StringFormat={}{0:HH:mm:ss}}" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="4" Classes="btn-stop-hdr" Content="⏹ Detener" Command="{Binding StopCommand}"
                        VerticalAlignment="Center" HorizontalAlignment="Right" Margin="18,0,0,0" />
            </Grid>
        </Panel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" Padding="20,10,20,0">
            <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch">
                <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsLoading}" Margin="0,0,0,10" />

                <Border Background="#33000000" CornerRadius="6" Padding="8,6" Margin="0,0,0,12"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#F04438" TextWrapping="Wrap" />
                </Border>

                <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource RewardGroupTemplate}" />
                <TextBlock Text="No se encontraron items." FontSize="13" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,30,0,0"
                           IsVisible="{Binding TotalCount, Converter={x:Static local:ZeroConverter.Instance}}" />

                <!-- Espaciador: asegura que el último grupo quede completamente visible al hacer scroll hasta el final -->
                <Border Height="24" />
            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="18,7">
            <Grid ColumnDefinitions="Auto,*">
                <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0"
                         Fill="{Binding IsPolling, Converter={x:Static local:PollingDotConverter.Instance}}" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11.5" Foreground="#6B7280" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Toasts -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToastItem">
                    <Border Background="White" BorderBrush="#12B76A" BorderThickness="0,0,0,0" CornerRadius="9"
                            Padding="13,9" Margin="0,0,0,8" Width="230" BoxShadow="0 4 16 0 #1A000000">
                        <StackPanel Spacing="2">
                            <TextBlock Text="🟢 Tienda actualizada" FontSize="11" FontWeight="Bold" Foreground="#12B76A" />
                            <TextBlock FontSize="12" Foreground="#111827" TextWrapping="Wrap">
                                <Run Text="{Binding ItemName}" FontWeight="Bold" />
                                <Run Text=" · " />
                                <Run Text="{Binding PriceText}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>

</UserControl>
