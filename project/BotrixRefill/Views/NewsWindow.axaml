<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BotrixRefill.Views.NewsWindow"
        Width="380" Height="320"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="BorderOnly"
        Background="White"
        Title="Novedades">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <TextBlock x:Name="TitleText" Grid.Row="0" Text="Novedades de la versión" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,10" />
        <ScrollViewer Grid.Row="1">
            <TextBlock x:Name="NotesText" FontSize="13" Foreground="#374151" TextWrapping="Wrap" />
        </ScrollViewer>
        <Button Grid.Row="2" Content="Entendido" Classes="btn-primary" HorizontalAlignment="Right" Margin="0,14,0,0" Click="CloseClick" />
    </Grid>
</Window>
